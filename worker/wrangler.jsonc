{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omsk-malifaux-campaign-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mrgyroscop-beep.github.io,http://localhost:4173,http://127.0.0.1:4173",
    "CLOUDFLARE_ACCOUNT_ID": "d714d517dea4f66b938faaf76b7bf38b",
    "AI_GATEWAY_ID": "default",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "DEEPSEEK_DIRECT_FALLBACK": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "BIGGERHAT_CACHE",
      "id": "31c98fd1a7814260a4cd2120fbded6f3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omsk-malifaux-campaigns",
      "database_id": "db08c172-2adf-4268-8f13-47d2d8c2f1c2",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "4107",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "4108",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "4109",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
