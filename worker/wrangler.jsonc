{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omsk-malifaux-campaign-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://mrgyroscop-beep.github.io,http://localhost:4173,http://127.0.0.1:4173",
    "DEEPSEEK_MODEL": "deepseek-v4-flash"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "4107",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
